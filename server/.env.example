# ── Server Environment Variables ────────────────────────────
# Set these in Render Dashboard → Environment → Environment Variables

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Port (Render sets this automatically, no need to set manually)
PORT=5000

# API key shared between client and server
API_KEY=utpatti-pm-api-key-2026

# Vercel frontend URL (for CORS allowlist)
CLIENT_URL=https://project-management-app-ashy-nu.vercel.app/ || https://project-management-app.shubhangguntaka.dev/
