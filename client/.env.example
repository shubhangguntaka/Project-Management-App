# ── Client Environment Variables ──────────────────────────────
# Set these in Vercel Dashboard → Settings → Environment Variables

# Full URL to your Render backend API (include /api suffix)
REACT_APP_API_URL=https://your-render-app.onrender.com/api

# API key that must match the server's API_KEY env var
REACT_APP_API_KEY=utpatti-pm-api-key-2026
